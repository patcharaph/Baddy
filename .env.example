# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.
#
# The app runs without any of these: it falls back to the sample session in
# src/lib/sample/session.ts so you can work on the UI before wiring a backend.

# --- LINE ------------------------------------------------------------------
# LIFF app id from the LINE Developers console (LINE Login channel > LIFF).
# The LIFF app needs the `openid` scope, or it returns no ID token to verify.
NEXT_PUBLIC_LIFF_ID=

# LINE Login channel id. Required for sign-in: the ID token is checked against
# this at https://api.line.me/oauth2/v2.1/verify before the caller is believed.
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=

# Messaging API channel, for waitlist promotions and settle-up pushes.
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=

# --- Supabase --------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS — never expose to the browser.
# Also used to verify LINE sign-ins and to link them to a player profile.
SUPABASE_SERVICE_ROLE_KEY=

# --- Development shortcut --------------------------------------------------
# Read with the service role instead of the signed-in user, so the screens show
# data before LINE sign-in is set up. Refuses to run in a production build.
# Leave unset once NEXT_PUBLIC_LIFF_ID and LINE_CHANNEL_ID are configured.
DEV_BYPASS_RLS=
