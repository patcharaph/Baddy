# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.
#
# The app runs without any of these: it falls back to the sample session in
# src/lib/sample/session.ts so you can work on the UI before wiring a backend.

# --- LINE ------------------------------------------------------------------
# LIFF app id from the LINE Developers console (LINE Login channel > LIFF).
NEXT_PUBLIC_LIFF_ID=

# LINE Login channel id/secret — used server-side to verify LIFF id tokens.
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=

# Messaging API channel, for waitlist promotions and settle-up pushes.
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=

# --- Supabase --------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
